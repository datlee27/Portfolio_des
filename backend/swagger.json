{
  "openapi": "3.0.3",
  "info": {
    "title": "Personal Portfolio & Blog API",
    "description": "Hệ thống RESTful API hoàn chỉnh quản lý Portfolio (Projects, Personal Info, Skills, Experience) và Blog (Posts, Views, Interactions). Tương thích hoàn toàn với WordPress/Hosting PHP & MySQL.",
    "version": "1.1.0",
    "contact": {
      "name": "Lê Văn Đạt",
      "email": "lvd27012004@gmail.com",
      "url": "https://datdoc.id.vn"
    }
  },
  "servers": [
    {
      "url": "https://datdoc.id.vn/api",
      "description": "Production Server (cPanel / WordPress Host)"
    },
    {
      "url": "http://localhost:3000/api",
      "description": "Local Development (Vite Proxy)"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Xác thực phiên làm việc Quản trị viên (Admin)" },
    { "name": "Portfolio", "description": "Dữ liệu tổng quan Portfolio, Dự án, Kỹ năng, Kinh nghiệm & Cá nhân" },
    { "name": "Blog", "description": "Quản lý Bài viết Blog, Nội dung, Lượt xem & Lượt thích" },
    { "name": "System", "description": "Cấu hình hệ thống, tạo bảng CSDL và tài liệu OpenAPI" }
  ],
  "paths": {
    "/auth.php": {
      "post": {
        "tags": ["Auth"],
        "summary": "Đăng nhập Quản trị viên (Admin Login)",
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "login" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "admin" },
                  "password": { "type": "string", "example": "admin123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Đăng nhập thành công, session cookie được cấp phát" },
          "401": { "description": "Sai tài khoản hoặc mật khẩu" }
        }
      },
      "get": {
        "tags": ["Auth"],
        "summary": "Kiểm tra phiên đăng nhập (check) hoặc Đăng xuất (logout)",
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["check", "logout"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Trả về trạng thái phiên làm việc hoặc đăng xuất thành công",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": { "logged_in": true, "username": "admin" },
                  "message": "Authenticated",
                  "timestamp": 1793554289
                }
              }
            }
          }
        }
      }
    },
    "/index.php?endpoint=portfolio": {
