    "/index.php?endpoint=setup-portfolio": {
      "get": {
        "tags": ["System"],
        "summary": "Tự động tạo các bảng MySQL và cập nhật cấu trúc schema mới nhất",
        "responses": { "200": { "description": "Tạo bảng và cập nhật cấu trúc thành công" } }
      }
    },
    "/index.php?endpoint=swagger": {
