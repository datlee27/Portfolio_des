        "summary": "Lấy chi tiết 1 bài viết Blog",
        "parameters": [
          { "name": "post_id", "in": "query", "required": false, "schema": { "type": "string", "example": "post-1" } },
          { "name": "id", "in": "query", "required": false, "schema": { "type": "integer" } }
