      }
    },
    "/index.php?endpoint=portfolio&type=project": {
      "post": {
        "tags": ["Portfolio"],
        "summary": "[Admin] Thêm dự án mới",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "project_code": { "type": "string", "example": "01" },
                  "title": { "type": "string", "example": "NetFit AI Fitness" },
                  "description": { "type": "string", "example": "AI-powered workout generator..." },
                  "image_url": { "type": "string", "example": "https://res.cloudinary.com/..." },
                  "body_images": { "type": "array", "items": { "type": "string" }, "example": ["https://res.cloudinary.com/..."] },
                  "tags": { "type": "array", "items": { "type": "string" }, "example": ["React", "TypeScript"] },
                  "github_url": { "type": "string", "example": "https://github.com/..." },
                  "deploy_url": { "type": "string", "example": "https://..." },
                  "video_demo": { "type": "string", "example": "https://youtu.be/..." },
                  "status": { "type": "string", "example": "Latest" },
                  "sort_order": { "type": "integer", "example": 1 },
                  "is_public": { "type": "boolean", "example": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Tạo dự án thành công" },
          "401": { "description": "Chưa xác thực Admin" }
        }
      },
      "put": {
        "tags": ["Portfolio"],
        "summary": "[Admin] Cập nhật dự án (hoặc cập nhật nhanh trạng thái hiển thị / thứ tự sắp xếp)",
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "integer", "example": 1 } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_code": { "type": "string" },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "image_url": { "type": "string" },
                  "body_images": { "type": "array", "items": { "type": "string" } },
                  "tags": { "type": "array", "items": { "type": "string" } },
                  "github_url": { "type": "string" },
                  "deploy_url": { "type": "string" },
                  "video_demo": { "type": "string" },
                  "status": { "type": "string" },
                  "sort_order": { "type": "integer" },
                  "is_public": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Cập nhật dự án thành công" },
          "401": { "description": "Chưa xác thực Admin" }
        }
      },
      "delete": {
        "tags": ["Portfolio"],
        "summary": "[Admin] Xóa dự án theo ID",
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "integer", "example": 1 } }
        ],
        "responses": {
          "200": { "description": "Xóa dự án thành công" },
          "401": { "description": "Chưa xác thực Admin" }
        }
      }
    },
    "/index.php?endpoint=portfolio&type=personal": {
      "put": {
        "tags": ["Portfolio"],
        "summary": "[Admin] Cập nhật thông tin cá nhân và liên hệ",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Lê Văn Đạt" },
                  "short_name": { "type": "string", "example": "Dat Lee" },
                  "title": { "type": "string", "example": "Software Engineer" },
                  "role": { "type": "string", "example": "Fullstack Developer" },
                  "bio": { "type": "string" },
                  "identity_statement": { "type": "string" },
                  "hero_subtext": { "type": "string" },
                  "status": { "type": "string" },
                  "coordinates": { "type": "string" },
                  "avatar_url": { "type": "string" },
                  "cv_url": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Cập nhật thành công" },
          "401": { "description": "Chưa xác thực Admin" }
        }
      }
    },
    "/index.php?endpoint=portfolio&type=skills": {
      "put": {
        "tags": ["Portfolio"],
        "summary": "[Admin] Đồng bộ danh sách tất cả các nhóm kỹ năng",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "category": { "type": "string", "example": "FRONTEND" },
                    "items": { "type": "array", "items": { "type": "string" }, "example": ["React", "TypeScript"] }
                  }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Đồng bộ kỹ năng thành công" } }
      }
    },
    "/index.php?endpoint=portfolio&type=experience": {
      "post": {
        "tags": ["Portfolio"],
        "summary": "[Admin] Thêm mốc hành trình / kinh nghiệm mới",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "company"],
                "properties": {
                  "title": { "type": "string", "example": "Software Engineer" },
                  "company": { "type": "string", "example": "Tech Studio" },
                  "period": { "type": "string", "example": "2025 - Present" },
                  "description": { "type": "string", "example": "Leading frontend development..." }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Thêm kinh nghiệm thành công" } }
      },
      "put": {
        "tags": ["Portfolio"],
        "summary": "[Admin] Cập nhật mốc kinh nghiệm theo ID hoặc đồng bộ toàn bộ danh sách",
        "parameters": [
          { "name": "id", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "company": { "type": "string" },
                  "period": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Cập nhật thành công" } }
      },
      "delete": {
        "tags": ["Portfolio"],
        "summary": "[Admin] Xóa mốc kinh nghiệm theo ID",
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Xóa thành công" } }
      }
    },
